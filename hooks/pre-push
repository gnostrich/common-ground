#!/usr/bin/env bash
# A RED SUITE MAY NOT REACH THE REMOTE.
#
# The rule existed and I broke it: a commit went out with one failing test because I read the
# tail of the output and pushed in the same breath. The fix for that is not more care. Every
# other invariant in this project is held by a control rather than by discipline, and this one
# was held by remembering — so it is a gate now.
#
# INSTALL: `./hooks/install` (sets core.hooksPath). Versioned, so a fresh clone or a reclaimed
# container gets it back with one command instead of losing it silently.
#
# THE ESCAPE HATCH IS GIT'S, NOT MINE. `git push --no-verify` skips every pre-push hook and
# cannot be disabled from inside one. That is stated rather than papered over: this gate stops
# the accident, which is what it is for, and it does not pretend to stop a decision.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# BOTH LINES TO STDERR. git forwards a hook's stderr to the terminal reliably and
# swallows its stdout in some transports, so a gate that reported success on stdout
# would be a gate nobody could see had run — indistinguishable from one that was
# never installed, which is the state this whole file exists to leave behind.
echo "[pre-push] running the suite — a red suite may not reach the remote" >&2
START=$(date +%s)
# A UNIQUE LOG PER RUN. The gate's own controls push inside a throwaway repository,
# which runs this hook again — a fixed path meant the inner run clobbered the outer
# one's log and the outer failure was reported with the inner repo's traceback.
LOG=$(mktemp -t prepush.XXXXXX)
if ! python3 -m unittest discover -s tests -q > "$LOG" 2>&1; then
    echo "[pre-push] REFUSED — the suite is red." >&2
    echo >&2
    grep -aE '^(FAIL|ERROR):' "$LOG" | head -20 >&2
    tail -3 "$LOG" >&2
    echo >&2
    echo "[pre-push] full output: $LOG" >&2
    echo "[pre-push] fix it, or push with --no-verify if you mean to." >&2
    exit 1
fi
echo "[pre-push] green in $(( $(date +%s) - START ))s — $(grep -aoE 'Ran [0-9]+ tests' "$LOG" | tail -1 || echo 'suite passed')" >&2
